{
  "rewrites": [
    { "source": "/comprar", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(comprar|admin)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "crons": [{ "path": "/api/reconciliar", "schedule": "0 13 * * *" }]
}
