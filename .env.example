# Variaveis configuradas no painel do Vercel (Settings > Environment Variables).
# Nunca versionar valores reais.

# Mesmo banco usado pela Megan (banco "megan", colecao "users")
MONGODB_URI=

# Resend: chave da API e remetente de um dominio verificado (ex.: Megan <teste@seudominio.com.br>)
RESEND_API_KEY=
EMAIL_FROM=

# Link de download do MeganN18.zip (Google Drive com acesso "qualquer pessoa com o link")
DOWNLOAD_URL=

# Teste: dias uteis da B3 e limite de contratos
TRIAL_BUSINESS_DAYS=10
TRIAL_CONTRACTS=1

# Contato exibido quando o teste vence (e-mail ou WhatsApp)
CONTATO_SUPORTE=

# Gerenciamento de risco (trade-manager): URL publica e chave da integracao
# A chave deve ser igual a MEGAN_INTEGRATION_KEY no trade-manager
TRADE_MANAGER_URL=
TRADE_MANAGER_API_KEY=

# URL publica do site, sem barra no final (retorno do Mercado Pago e webhook)
SITE_URL=

# Mercado Pago (Suas integracoes > Credenciais de producao): Access Token
MP_ACCESS_TOKEN=
# Mercado Pago (Suas integracoes > Webhooks): assinatura secreta do webhook /api/mercadopago
MP_WEBHOOK_SECRET=

# Segredo da revisão de compras pagas cujo aviso se perdeu (/api/reconciliar).
# Cron do Vercel (Hobby): 1x por dia. Para rodar a cada 15 min use um agendador externo
# (ex.: cron-job.org) chamando a rota com o header "Authorization: Bearer <CRON_SECRET>".
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Chave privada Ed25519 (PKCS8 DER em base64) — gerar com: npm run gerar-chaves
LICENSE_SIGNING_KEY=
